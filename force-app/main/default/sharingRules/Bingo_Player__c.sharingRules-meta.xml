<?xml version="1.0" encoding="UTF-8"?>
<!-- Read is the only access level guest sharing rules support; the guest never
     needs more, because every write is an INSERT. -->
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Bingo_Player_Readable_By_Guest</fullName>
        <accessLevel>Read</accessLevel>
        <criteriaItems>
            <field>Email__c</field>
            <operation>contains</operation>
            <value>@</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
        <label>Bingo_Player Readable By Guest</label>
        <sharedTo>
            <guestUser>Networking_Bingo</guestUser>
        </sharedTo>
    </sharingGuestRules>
</SharingRules>
