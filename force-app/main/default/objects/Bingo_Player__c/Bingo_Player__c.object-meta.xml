<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>A participant, keyed by email. Written once and never updated: guest users cannot perform UPDATE.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Bingo Player</label>
    <nameField><displayFormat>BP-{00000}</displayFormat><label>Player Number</label><type>AutoNumber</type></nameField>
    <pluralLabel>Bingo Players</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
