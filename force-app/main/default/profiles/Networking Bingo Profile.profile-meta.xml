<?xml version="1.0" encoding="UTF-8"?>
<!--
    Guest User Profile for the Networking Bingo site.
    Phase 0 proved `without sharing` Apex does NOT bypass object permissions for
    guest users, and that non-required fields need explicit FLS or they behave as
    if they do not exist. Required fields are omitted on purpose: they bypass FLS
    and deploying them here fails with "You cannot deploy to a required field."
-->
<Profile xmlns="http://soap.sforce.com/2006/04/metadata">
    <custom>false</custom>
<classAccesses>
        <apexClass>BingoService</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Bingo_Prompt__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Bingo_Player__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Bingo_Mark__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Bingo_Prompt__c.Active__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Bingo_Player__c.Display_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Bingo_Player__c.Consented__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Bingo_Player__c.Consented_At__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Bingo_Mark__c.Met_Person_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Bingo_Mark__c.Cleared__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Bingo_Mark__c.Prompt_Text__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Bingo_Mark__c.Met_Player_Email__c</field>
        <readable>true</readable>
    </fieldPermissions>
</Profile>
